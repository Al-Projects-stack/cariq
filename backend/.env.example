ANTHROPIC_API_KEY=your_anthropic_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=cariq-kb
PINECONE_ENVIRONMENT=us-east-1
DATABASE_URL=postgresql://cariq:cariq@localhost:5432/cariq
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
DASHBOARD_TOKEN=change-me
CLAUDE_MAX_RETRIES=3
CLAUDE_BASE_DELAY=1.0
# Admin dashboard: generate with `python -c "import secrets; print(secrets.token_hex(32))"`.
# Login refuses to run in production while JWT_SECRET is still "change-me".
JWT_SECRET=change-me
# Salt for hashing user IPs before storing in query logs. Any long random string.
IP_HASH_SALT=change-me
# Self-healing admin seed (see app/main.py). If both are set, this admin is
# (re)created on every startup - this is how the admin survives SQLite wipes
# on ephemeral hosting. Leave empty for local dev and use scripts/create_admin.py.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Top similarity score below this marks a query as weak/failed for review.
FAILURE_SCORE_THRESHOLD=0.45
